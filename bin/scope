#!/usr/bin/env php
<?php

/**
 * Copies the package into a plugin under the plugin's own namespace,
 * so plugins that bundle different versions never share a class.
 *
 * Usage: php vendor/bin/scope <namespace> <directory>
 * e.g.:  php vendor/bin/scope "Oweb\InstagramFeed\License" lib/license
 *
 * The plugin then loads it in its `index.php`:
 * require_once __DIR__ . '/lib/license/autoload.php';
 */

const SOURCE    = 'Oweb\\License';
const GENERATED = 'Generated by owebstudio/kirby-license';

function fail(string $message): never
{
	fwrite(STDERR, $message . PHP_EOL);
	exit(1);
}

$namespace = trim($argv[1] ?? '', '\\');
$target    = rtrim($argv[2] ?? '', '/\\');

if ($namespace === '' || $target === '') {
	fail('Usage: scope <namespace> <directory>');
}

if (preg_match('/^[A-Za-z_][A-Za-z0-9_]*(\\\\[A-Za-z_][A-Za-z0-9_]*)*$/', $namespace) !== 1) {
	fail('Invalid namespace: ' . $namespace);
}

if ($namespace === SOURCE) {
	fail('Please use the namespace of your plugin, not ' . SOURCE);
}

$source = dirname(__DIR__) . '/src';

// only replace a directory that was generated before
if (is_dir($target) === true) {
	$autoload = $target . '/autoload.php';
	$empty    = count(scandir($target)) === 2;

	if (
		$empty === false &&
		(is_file($autoload) === false || str_contains(file_get_contents($autoload), GENERATED) === false)
	) {
		fail('The directory ' . $target . ' exists and was not generated by this script');
	}

	$files = new RecursiveIteratorIterator(
		new RecursiveDirectoryIterator($target, FilesystemIterator::SKIP_DOTS),
		RecursiveIteratorIterator::CHILD_FIRST
	);

	foreach ($files as $file) {
		$file->isDir() === true ? rmdir($file->getPathname()) : unlink($file->getPathname());
	}
} elseif (mkdir($target, 0755, true) === false) {
	fail('The directory ' . $target . ' could not be created');
}

$files = new RecursiveIteratorIterator(
	new RecursiveDirectoryIterator($source, FilesystemIterator::SKIP_DOTS)
);

$version = null;
$count   = 0;

foreach ($files as $file) {
	if ($file->getExtension() !== 'php') {
		continue;
	}

	$relative = substr($file->getPathname(), strlen($source) + 1);
	$code     = file_get_contents($file->getPathname());
	$code     = str_replace('namespace ' . SOURCE . ';', 'namespace ' . $namespace . ';', $code);

	// references in docblocks
	$code = str_replace('\\' . SOURCE . '\\', '\\' . $namespace . '\\', $code);

	if (preg_match('/(?<!\w)' . preg_quote(SOURCE, '/') . '(?!\w)/', $code) === 1) {
		fail('Unexpected reference to ' . SOURCE . ' in ' . $relative);
	}

	if ($relative === 'License.php' && preg_match("/const VERSION = '([^']+)'/", $code, $match) === 1) {
		$version = $match[1];
	}

	$path = $target . '/' . str_replace('\\', '/', $relative);

	if (is_dir(dirname($path)) === false) {
		mkdir(dirname($path), 0755, true);
	}

	file_put_contents($path, $code);
	$count++;
}

$prefix   = var_export($namespace . '\\', true);
$autoload = <<<PHP
<?php

// {GENERATED} {$version}. Do not edit.
// Update with: php vendor/bin/scope "{$namespace}" <directory>

spl_autoload_register(function (string \$class): void {
	\$prefix = {$prefix};

	if (str_starts_with(\$class, \$prefix) === false) {
		return;
	}

	\$file = __DIR__ . '/' . str_replace('\\\\', '/', substr(\$class, strlen(\$prefix))) . '.php';

	if (is_file(\$file) === true) {
		require \$file;
	}
});

PHP;

file_put_contents($target . '/autoload.php', str_replace('{GENERATED}', GENERATED, $autoload));

echo 'Copied ' . $count . ' files of owebstudio/kirby-license ' . $version . ' to ' . $target . ' (' . $namespace . ')' . PHP_EOL;
